desc:LG Analog Meters (VU / Dorrough-style / SSL-style plasma)
tags: analysis meter vu ppm loudness
author: Ilia Lukashev
version: 1.0
changelog: First ReaPack release
// Click the meter to switch type. Alt+click resets peak holds.
// Ballistics:
//   VU      - mechanical 2nd-order movement on the full-wave rectified signal:
//             99% of reading in 300 ms, ~1.2% overshoot (zeta 0.813, wn 13.5 rad/s); scale linear in voltage.
//   Dorrough-style - average arc (rectified, ~600 ms to 99%) + instant peak segment (13.3 dB/s fall, hold).
//   Plasma  - VU mode: 300 ms critically damped (no needle mass) / PPM mode: DIN quasi-peak
//             (fast attack, 20 dB in 1.5 s fall) + peak-hold segment. Neon-orange gas columns.
// Reference: the dBFS level of a sine (peak) that reads 0 VU / 0 dB. +4 dBu = -18 dBFS is the usual alignment.

slider1:mode=0<0,2,1{Analog VU,Dorrough-style (peak + average),SSL-style plasma}>Meter
slider2:ref=-18<-24,-6,0.5>Reference (dBFS sine = 0)
slider3:pball=1<0,1,1{VU,PPM (DIN)}>Plasma ballistics
slider4:holdS=1.5<0,5,0.1>Peak hold (s)
slider5:glow=0.7<0,1.5,0.05>Glow

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
gfx_ext_retina = 1;
vuY = 0; vuV = 2; avg = 4; pk = 6; hold = 8; holdT = 10; ppm = 12; pvY = 14; pvV = 16; led = 18;
marks = 100;   // VU scale marks
marks[0] = -20; marks[1] = -10; marks[2] = -7; marks[3] = -5; marks[4] = -3; marks[5] = -2;
marks[6] = -1;  marks[7] = 0;   marks[8] = 1;  marks[9] = 2;  marks[10] = 3;
dmarks = 120;  // Dorrough-style labels
dmarks[0] = -30; dmarks[1] = -20; dmarks[2] = -10; dmarks[3] = -5; dmarks[4] = 0; dmarks[5] = 4; dmarks[6] = 8; dmarks[7] = 14;
pmarks = 140;  // plasma labels
pmarks[0] = -40; pmarks[1] = -30; pmarks[2] = -20; pmarks[3] = -10; pmarks[4] = -5; pmarks[5] = 0; pmarks[6] = 5; pmarks[7] = 10; pmarks[8] = 18;
lastcap = 0;

function db(v) ( v > 0.00001 ? 20 * log10(v) : -100; );

// ---------- scale mappings (dB -> 0..1 along the scale)
function vuF(d) ( 10 ^ (d / 20) / 1.41254; );              // VU: linear in voltage, +3 VU = 141%
function dorF(d) (
  d < -20 ? max(0, (d + 40) / 100) : d < 0 ? 0.2 + (d + 20) / 20 * 0.52 : min(1, 0.72 + d / 14 * 0.28);
);
function dorInv(f) (
  f < 0.2 ? -40 + f * 100 : f < 0.72 ? -20 + (f - 0.2) / 0.52 * 20 : (f - 0.72) / 0.28 * 14;
);
function plF(d) (
  d < -20 ? max(0, (d + 40) / 20 * 0.25) : d < 0 ? 0.25 + (d + 20) / 20 * 0.5 : min(1, 0.75 + d / 18 * 0.25);
);
function plInv(f) (
  f < 0.25 ? -40 + f / 0.25 * 20 : f < 0.75 ? -20 + (f - 0.25) / 0.5 * 20 : (f - 0.75) / 0.25 * 18;
);

function col(rr, gg, bb, aa) ( gfx_r = rr; gfx_g = gg; gfx_b = bb; gfx_a = aa; );

function textc(s, x, y) local(tw, th) (
  gfx_measurestr(s, tw, th);
  gfx_x = x - tw / 2; gfx_y = y - th / 2;
  gfx_drawstr(s);
);

// glow layer: everything lit is also drawn at 1/4 scale into image 1, then blurred and added
function glowRect(x, y, w, h) (
  gfx_dest = 1; gfx_rect(x * 0.25, y * 0.25, max(1, w * 0.25), max(1, h * 0.25)); gfx_dest = -1;
);
function glowDisc(x, y, rr) (
  gfx_dest = 1; gfx_circle(x * 0.25, y * 0.25, max(0.6, rr * 0.25), 1, 1); gfx_dest = -1;
);

// ---------- ANALOG VU
function vuMeter(x, y, w, h, v, ledOn, lbl)
  local(m, fx, fy, fw, fh, px, py, R, Rs, A, i, d, f, an, s, c, rr, fs, tipx, tipy, lip, k, big)
(
  // bezel
  col(0.09, 0.09, 0.10, 1); gfx_rect(x, y, w, h);
  m = 3 * r; fx = x + m; fy = y + m; fw = w - 2 * m; fh = h - 2 * m;
  fw < 24 || fh < 18 ? ( fw = 0; ) : (
  big = fw >= 110 && fh >= 60;
  // warm back-lit face
  fx = floor(fx); fy = floor(fy); fw = floor(fw); fh = floor(fh);
  gfx_gradrect(fx, fy, fw, fh, 0.985, 0.94, 0.78, 1, 0, 0, 0, 0, -0.09 / fh, -0.12 / fh, -0.17 / fh, 0);
  col(1, 0.85, 0.55, 0.10); gfx_circle(fx + fw / 2, fy + fh * 0.35, fh * 0.45, 1, 1);   // lamp hot-spot
  px = fx + fw / 2; py = fy + fh * 1.10;
  R = fh * 0.98; Rs = min(fh * 0.80, fw * 0.62);
  A = 0.80;
  // scale arc: black to 0, red band 0..+3
  col(0.08, 0.07, 0.06, 0.9);
  gfx_arc(px, py, Rs, -A + 2 * A * vuF(-20), -A + 2 * A * vuF(0), 1);
  gfx_arc(px, py, Rs + 0.7 * r, -A + 2 * A * vuF(-20), -A + 2 * A * vuF(0), 1);
  col(0.80, 0.10, 0.08, 0.95);
  rr = 0; loop(ceil(5 * r), gfx_arc(px, py, Rs + rr, -A + 2 * A * vuF(0), -A + 2 * A * vuF(3), 1); rr += 0.8; );
  // ticks + numerals
  fs = max(8, fh * 0.085);
  gfx_setfont(1, "Arial", fs);
  i = 0;
  loop(11,
    d = marks[i]; f = vuF(d); an = -A + 2 * A * f;
    s = sin(an); c = cos(an);
    d > 0 ? col(0.78, 0.08, 0.06, 1) : col(0.08, 0.07, 0.06, 1);
    k = (d == -20 || d == -10 || d == -5 || d == 0 || d == 3) ? 9 : 6;
    !big ? ( k *= 0.5; );
    gfx_line(px + s * Rs, py - c * Rs, px + s * (Rs + k * r), py - c * (Rs + k * r), 1);
    gfx_line(px + s * Rs + 0.6, py - c * Rs, px + s * (Rs + k * r) + 0.6, py - c * (Rs + k * r), 1);
    big ? (
      sprintf(#n, "%d", abs(d));
      textc(#n, px + s * (Rs + 9 * r + fs * 0.75), py - c * (Rs + 9 * r + fs * 0.75));
    );
    i += 1;
  );
  big ? (
    col(0.08, 0.07, 0.06, 1); textc("-", px + sin(-A - 0.07) * (Rs + 2 * fs), py - cos(-A - 0.07) * (Rs + 2 * fs));
    col(0.78, 0.08, 0.06, 1); textc("+", px + sin(A + 0.07) * (Rs + 2 * fs), py - cos(A + 0.07) * (Rs + 2 * fs));
  );
  // percent sub-scale (thin, under the arc)
  col(0.08, 0.07, 0.06, 0.45);
  f = 0; loop(11, an = -A + 2 * A * f / 1.41254; gfx_line(px + sin(an) * (Rs - 4 * r), py - cos(an) * (Rs - 4 * r), px + sin(an) * Rs, py - cos(an) * Rs, 1); f += 0.1; );
  gfx_setfont(2, "Arial", fs * 1.9, 'b');
  fh >= 50 ? ( col(0.10, 0.09, 0.08, 0.85); textc("VU", px, fy + fh * 0.60); );
  // needle (mechanical stops just past the ends)
  f = max(-0.03, min(1.08, v / 1.41254));
  an = -A + 2 * A * f; s = sin(an); c = cos(an);
  tipx = px + s * R * 0.97; tipy = py - c * R * 0.97;
  col(0, 0, 0, 0.16);
  gfx_line(px + 2.5 * r, py + 1.5 * r, tipx + 2.5 * r, tipy + 1.5 * r, 1);         // soft shadow on the face
  col(0.05, 0.05, 0.05, 0.95);
  gfx_line(px, py, tipx, tipy, 1);
  gfx_line(px + 0.7 * r, py, tipx + 0.5 * r, tipy, 1);
  // lower lip hiding the pivot
  lip = floor(fy + fh * 0.80);
  gfx_gradrect(fx, lip, fw, max(1, floor(fy + fh - lip)), 0.17, 0.16, 0.15, 1, 0, 0, 0, 0, -0.08 / fh, -0.08 / fh, -0.08 / fh, 0);
  gfx_setfont(1, "Arial", fs);
  big ? ( col(0.75, 0.72, 0.66, 0.85); textc(lbl, px, lip + (fy + fh - lip) / 2); );
  // peak LED
  ledOn ? (
    col(1, 0.16, 0.08, 1); gfx_circle(fx + fw - 9 * r, fy + 9 * r, 3.2 * r, 1, 1);
    glowDisc(fx + fw - 9 * r, fy + 9 * r, 7 * r);
  ) : (
    col(0.35, 0.06, 0.04, 1); gfx_circle(fx + fw - 9 * r, fy + 9 * r, 3.2 * r, 1, 1);
  );
  // glass reflection
  gfx_gradrect(fx, fy, fw, floor(fh * 0.45), 1, 1, 1, 0.10, 0, 0, 0, 0, 0, 0, 0, -0.10 / max(1, fh * 0.45));
  );
);

// ---------- DORROUGH-STYLE arc
function dorMeter(x, y, w, h, avgDb, pkDb, lbl)
  local(cx, cy, R, N, k, f, d, a0, a1, ri, ro, lit, pki, cr, cg, cb, fs, i, an, ha)
(
  col(0.055, 0.055, 0.06, 1); gfx_rect(x, y, max(1, w), max(1, h));
  cx = x + w / 2; cy = y + h * 0.86;
  R = max(10, min(w * 0.44, h * 0.74));
  N = 54;
  ri = R * 0.72; ro = R * 0.96;
  pki = floor(dorF(pkDb) * N);
  pkDb < -40 ? ( pki = -1; );
  k = 0;
  loop(N,
    f = (k + 0.5) / N; d = dorInv(f);
    an = -1.5708 + 3.1416 * f;
    ha = 3.1416 / N * 0.36;
    a0 = an - ha; a1 = an + ha;
    d < 0 ? ( cr = 0.20; cg = 0.95; cb = 0.38; ) : d < 8 ? ( cr = 1.0; cg = 0.70; cb = 0.10; ) : ( cr = 1.0; cg = 0.18; cb = 0.12; );
    lit = d <= avgDb || k == pki;
    lit ? col(cr, cg, cb, 1) : col(cr * 0.13, cg * 0.13, cb * 0.13, 1);
    gfx_triangle(cx + sin(a0) * ri, cy - cos(a0) * ri, cx + sin(a0) * ro, cy - cos(a0) * ro,
                 cx + sin(a1) * ro, cy - cos(a1) * ro, cx + sin(a1) * ri, cy - cos(a1) * ri);
    lit ? (
      k == pki ? col(min(1, cr + 0.3), min(1, cg + 0.3), min(1, cb + 0.3), 1);
      glowDisc(cx + sin(an) * (ri + ro) / 2, cy - cos(an) * (ri + ro) / 2, (ro - ri) * 0.9);
    );
    k += 1;
  );
  fs = max(8, R * 0.11);
  gfx_setfont(1, "Arial", fs);
  i = 0;
  loop(8,
    d = dmarks[i]; an = -1.5708 + 3.1416 * dorF(d);
    d == 0 ? col(0.95, 0.95, 0.95, 0.9) : col(0.62, 0.62, 0.66, 0.85);
    d > 0 ? sprintf(#n, "+%d", d) : sprintf(#n, "%d", d);
    textc(#n, cx + sin(an) * (ro + fs * 1.1), cy - cos(an) * (ro + fs * 1.1));
    i += 1;
  );
  col(0.62, 0.62, 0.66, 0.85); textc(lbl, cx, cy - R * 0.25);
);

// ---------- SSL-style plasma column
function plasmaBar(x, y, w, h, valDb, holdDb)
  local(pitch, segh, n, k, f, d, yy, lit, hk, top)
(
  pitch = 3 * r; segh = 2 * r;
  n = max(0, min(400, floor(h / pitch)));
  hk = holdDb > -40 ? floor(plF(holdDb) * n) : -1;
  top = -1;
  k = 0;
  loop(n,
    f = (k + 0.5) / n; d = plInv(f);
    yy = y + h - (k + 1) * pitch;
    lit = d <= valDb;
    lit ? ( col(1.0, 0.42, 0.10, 1); top = yy; ) :
    k == hk ? col(1.0, 0.55, 0.20, 1) :
              col(0.15, 0.05, 0.02, 1);
    gfx_rect(x, yy, w, segh);
    k == hk ? glowRect(x, yy, w, segh * 1.5);
    k += 1;
  );
  top >= 0 ? (
    col(1.0, 0.42, 0.10, 1); glowRect(x, top, w, y + h - top);
    col(1.0, 0.85, 0.65, 0.20); gfx_rect(x + w * 0.3, top, w * 0.4, y + h - top);   // hot core of the gas column
  );
);

function plasmaPanel(x, y, w, h, v0, h0, v1, h1)
  local(mt, mb, bw, lab, cx, by, bh, i, d, yy, fs)
(
  col(0.045, 0.030, 0.025, 1); gfx_rect(x, y, w, h);
  mt = 8 * r; mb = 14 * r;
  cx = x + w / 2;
  lab = max(20 * r, min(w * 0.30, 30 * r));
  bw = max(4 * r, min((w - lab) / 2 - 4 * r, 26 * r));   // fill narrow strips, cap on wide windows
  by = y + mt; bh = max(10, h - mt - mb);
  plasmaBar(cx - lab / 2 - bw, by, bw, bh, v0, h0);
  plasmaBar(cx + lab / 2, by, bw, bh, v1, h1);
  fs = max(7, min(lab * 0.36, 11 * r));
  gfx_setfont(1, "Arial", fs);
  i = 0;
  loop(9,
    d = pmarks[i];
    yy = by + bh - plF(d) * bh;
    d == 0 ? col(1, 0.75, 0.55, 0.95) : col(0.85, 0.55, 0.40, 0.75);
    d > 0 ? sprintf(#n, "+%d", d) : sprintf(#n, "%d", d);
    textc(#n, cx, yy);
    i += 1;
  );
  col(0.85, 0.55, 0.40, 0.75);
  textc("L", cx - lab / 2 - bw / 2, y + h - mb / 2);
  textc("R", cx + lab / 2 + bw / 2, y + h - mb / 2);
);

@slider
refLin = 10 ^ (ref / 20);
kv = 1 / (0.63662 * refLin);       // rectified average of a sine at reference -> 1.0
kp = 1 / refLin;                   // sine peak at reference -> 1.0
dt = 1 / srate;
W2 = 13.5215 * 13.5215;  Z2 = 2 * 0.813 * 13.5215;      // VU needle
W2c = 22.132 * 22.132;   Z2c = 2 * 22.132;              // plasma VU, critically damped
ca = 1 - exp(-1 / (0.13 * srate));                      // Dorrough-style average
cAtt = 1 - exp(-1 / (0.0025 * srate));                  // PPM attack
rel = 10 ^ (-13.33 / 20 / srate);                       // 20 dB in 1.5 s
holdN = holdS * srate;

@sample
ch = 0;
loop(2,
  x = abs(ch == 0 ? spl0 : spl1);
  xr = x * kv; xp = x * kp;
  // VU needle: 2nd-order movement
  a = W2 * (xr - vuY[ch]) - Z2 * vuV[ch];
  vuV[ch] += a * dt; vuY[ch] += vuV[ch] * dt;
  vuY[ch] < 0 ? ( vuY[ch] = 0; vuV[ch] = max(vuV[ch], 0); );
  vuY[ch] > 1.53 ? ( vuY[ch] = 1.53; vuV[ch] = min(vuV[ch], 0); );   // pin stop
  // plasma VU (no mass)
  a = W2c * (xr - pvY[ch]) - Z2c * pvV[ch];
  pvV[ch] += a * dt; pvY[ch] += pvV[ch] * dt;
  // average
  avg[ch] += (xr - avg[ch]) * ca;
  // peak
  pk[ch] = xp > pk[ch] ? xp : pk[ch] * rel;
  xp >= hold[ch] ? ( hold[ch] = xp; holdT[ch] = holdN; ) : ( holdT[ch] > 0 ? ( holdT[ch] -= 1; ) : ( hold[ch] *= rel; ); );
  // PPM quasi-peak
  ppm[ch] = xp > ppm[ch] ? ppm[ch] + (xp - ppm[ch]) * cAtt : ppm[ch] * rel;
  // overload LED (-2 dBFS)
  x > 0.794 ? ( led[ch] = 0.25 * srate; ) : ( led[ch] > 0 ? ( led[ch] -= 1; ); );
  ch += 1;
);

@gfx 520 220
r = gfx_ext_retina > 1 ? 2 : 1;
W = gfx_w; H = gfx_h;
W >= 30 * r && H >= 24 * r ? (

// mouse: click = next meter type, Alt+click = reset peaks
cap = mouse_cap & 1;
cap && !lastcap ? (
  mouse_cap & 16 ? ( hold[0] = hold[1] = 0; pk[0] = pk[1] = 0; ) : ( mode = (mode + 1) % 3; sliderchange(slider1); );
);
lastcap = cap;

gw = max(2, ceil(W / 4)); gh = max(2, ceil(H / 4));
gfx_setimgdim(1, gw, gh);
gfx_dest = 1; gfx_mode = 0; col(0, 0, 0, 1); gfx_rect(0, 0, gw, gh); gfx_dest = -1;

col(0.06, 0.06, 0.065, 1); gfx_rect(0, 0, W, H);
gap = 4 * r;
side = W >= H * 1.25;

mode == 0 ? (
  side ? (
    vuMeter(0, 0, (W - gap) / 2, H, vuY[0], led[0] > 0, "L");
    vuMeter((W + gap) / 2, 0, (W - gap) / 2, H, vuY[1], led[1] > 0, "R");
  ) : (
    vuMeter(0, 0, W, (H - gap) / 2, vuY[0], led[0] > 0, "L");
    vuMeter(0, (H + gap) / 2, W, (H - gap) / 2, vuY[1], led[1] > 0, "R");
  );
) : mode == 1 ? (
  side ? (
    dorMeter(0, 0, (W - gap) / 2, H, db(avg[0]), db(pk[0]), "L");
    dorMeter((W + gap) / 2, 0, (W - gap) / 2, H, db(avg[1]), db(pk[1]), "R");
  ) : (
    dorMeter(0, 0, W, (H - gap) / 2, db(avg[0]), db(pk[0]), "L");
    dorMeter(0, (H + gap) / 2, W, (H - gap) / 2, db(avg[1]), db(pk[1]), "R");
  );
) : (
  pball ? plasmaPanel(0, 0, W, H, db(ppm[0]), db(hold[0]), db(ppm[1]), db(hold[1]))
        : plasmaPanel(0, 0, W, H, db(pvY[0]), db(hold[0]), db(pvY[1]), db(hold[1]));
);

// bloom: blur the quarter-res glow layer and add it on top
gfx_dest = 1;
gfx_x = 0; gfx_y = 0; gfx_blurto(gw, gh);
gfx_x = 0; gfx_y = 0; gfx_blurto(gw, gh);
gfx_dest = -1;
gfx_mode = 1;
gfx_a = glow;
gfx_blit(1, 1, 0, 0, 0, gw, gh, 0, 0, W, H);
gfx_mode = 0;
) : (
  // too small to draw a meter: plain background only
  gfx_r = gfx_g = gfx_b = 0.06; gfx_a = 1; gfx_mode = 0;
  W > 0 && H > 0 ? gfx_rect(0, 0, W, H);
);
